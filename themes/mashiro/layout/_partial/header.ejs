<div id="nav-outer">
  <nav id="main-nav" class="outer">
    <a id="main-nav-toggle" class="nav-icon"></a>
    <% for (var i in theme.menu){ %>
      <% var isAct=false; %>
        <% if (theme.menu[i]=='/' || theme.menu[i]=='/index.html' ) { %>
          <% if (is_home()) isAct=true; %>
            <% } else { %>
              <% if (is_current(theme.menu[i])) isAct=true; %>
                <% } %>
                  <a class="main-nav-link<%= isAct ? ' current' : '' %>"
                    href="<%- url_for(theme.menu[i], {relative: theme.menu[i][0] != '/'}) %>">
                    <%= i %>
                  </a>
                  <% } %>
                    <div class="main-nav-space-between"></div>
                    <% if (theme.rss){ %>
                      <a id="nav-rss-link" class="nav-icon"
                        href="<%- url_for(theme.rss, {relative: theme.menu[i][0] != '/'}) %>"
                        title="<%= __('rss_feed') %>"></a>
                      <% } %>
  </nav>
</div>
<div id="header-title" class="<%= is_archive() ? 'header-archive-mode' : '' %>">
  <h1 id="logo-wrap">
    <a href="<%- url_for() %>" id="logo">
      <% if (is_category()) { %>
        <%= page.category %>
          <% } else if (is_tag()) { %>
            <%= page.tag %>
              <% } else if (is_archive()) { %>

                <% } else if (is_post()) { %>
                  <%= page.title %>
                    <% } else { %>
                      <%= config.title.replace(/，/g, ', ' ).replace(/；/g, '; ' ).replace(/：/g, ': ' ).replace(/！/g, '! '
                        ).replace(/‘/g, '` ' ).replace(/’/g, "' " ).replace(/“/g, ' “' ).replace(/”/g, "” "
                        ).replace(/（/g, ' (' ).replace(/）/g, ') ' ).replace(/。/g, '. ' ).replace(/？/g, '? ' ) %>
                        <% } %>
    </a>
  </h1>
  <% if (!is_post() && (theme.subtitle || config.subtitle)){ %>
    <h2 id="subtitle-wrap">
      <a href="<%- url_for() %>" id="subtitle">
        <%= (theme.subtitle || config.subtitle).replace(/，/g, ', ' ).replace(/；/g, '; ' ).replace(/：/g, ': '
          ).replace(/！/g, '! ' ).replace(/‘/g, '` ' ).replace(/’/g, "' " ).replace(/“/g, ' “' ).replace(/”/g, "” "
          ).replace(/（/g, ' (' ).replace(/）/g, ') ' ).replace(/。/g, '. ' ).replace(/？/g, '? ' ) %>
      </a>
    </h2>
    <% } %>
</div>