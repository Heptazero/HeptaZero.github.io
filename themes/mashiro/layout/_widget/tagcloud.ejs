<% if (site.tags.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title">
      <%= __('tagcloud') %>
    </h3>
    <div class="widget tagcloud">
      <%- tagcloud({min_font: 15, max_font: 22, amount: 200, color: true, start_color: '#999' , end_color: '#111' }) %>
    </div>
  </div>
  <% } %>