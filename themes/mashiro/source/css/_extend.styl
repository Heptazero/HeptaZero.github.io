$block-caption
  // 模块标题通用样式：去下划线，灰色，底部间距
  text-decoration: none
  color: color-grey
  margin-bottom: 1em
  line-height: 1em
  font-weight: bold

$block
  // 基础内容块样式：白色背景，底部边框
  background: #fff
  border-bottom: 1px solid color-border

$base-style
  // 基础排版样式：定义各级标题字体大小
  h1
    font-size: 2em
  h2
    font-size: 1.5em
  h3
    font-size: 1.3em
  h4
    font-size: 1.2em
  h5
    font-size: 1em
  h6
    font-size: 1em
    color: color-grey
  // 分割线样式
  hr
    border: 0.5px solid color-border
  // 粗体和斜体
  strong
    font-weight: bold
  em, cite
    font-style: italic
  // 上标和下标
  sup, sub
    font-size: 0.75em
    line-height: 0
    position: relative
    vertical-align: baseline
  sup
    top: -0.5em
  sub
    bottom: -0.2em
  small
    font-size: 0.85em
  acronym, abbr
    border-bottom: 1px dotted
  // 列表样式：外边距和行高
  ul, ol, dl
    margin: 0 2*article-padding
    line-height: line-height
  ul, ol
    ul, ol
      margin-top: 0
      margin-bottom: 0
  ul
    list-style: disc
  ol
    list-style: decimal
  dt
    font-weight: bold

$title-number
  // 标题自动编号计数器样式
  counter-reset: h2
  h2
    &:before
      padding-right: 1em
      counter-increment: h2
      content: counter(h2)
    counter-reset: h3
  h3
    &:before
      padding-right: 1em
      counter-increment: h3
      content: counter(h2) "." counter(h3)
    counter-reset: h4
  h4
    &:before
      padding-right: 1em
      counter-increment: h4
      content: counter(h2) "." counter(h3) "." counter(h4)
    counter-reset: h5
  h5
    &:before
      padding-right: 1em
      counter-increment: h5
      content: counter(h2) "." counter(h3) "." counter(h4) "." counter(h5)
    counter-reset: h6

$variable-width
  // 响应式宽度控制：决定页面内容主体（包括文章和侧边栏）的总宽度
  // 想调整侧边栏距离屏幕边缘的距离，通过修改这里的 width
  if (sidebar) and !(sidebar is bottom)
    @media screen
      width: 100% // 桌面端默认宽度，增加此值可使内容更宽，侧边栏更靠边
  else
    @media screen
      width: 44em
  
  // 针对不同屏幕宽度的媒体查询适配
