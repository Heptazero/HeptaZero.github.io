#footer
  background: #fff
  margin-top: auto
  padding: 30px 0
  color: #555
  transition: transform 0.3s ease-out
  .mobile-nav-on &
    transform: translateX(140px)
  a
    color: color-link
    text-decoration: none
    &:hover
      text-decoration: none
      font-weight: bold
      color: #000

#footer-info
  line-height: line-height
  font-size: 0.85em
  text-align: center