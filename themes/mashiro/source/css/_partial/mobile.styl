#mobile-nav
  position: fixed
  top: 0
  left: 0
  width: 280px
  height: 100%
  background: #fff
  border-right: 1px solid #ddd
  transform: translateX(-100%)
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1)
  will-change: transform
  z-index: 9999
  overflow-y: auto
  .mobile-nav-on &
    transform: translateX(0)
  @media mq-mobile
    width: 70vw
    .mobile-nav-on &
      transform: translateX(0)

.mobile-nav-categories
  padding: 20px
  h3.widget-title
    font-size: 20px
    color: #000
    font-weight: bold
    margin-bottom: 15px
  ul
    margin: 0
    padding: 0
    list-style: none
    ul
      padding-left: 20px
      list-style: disc
    li
      padding: 5px 0
      a
        color: #666
        text-decoration: none
        &:hover
          color: #000
          font-weight: bold

.mobile-nav-tagcloud
  position: absolute
  bottom: 0
  left: 0
  width: 100%
  background: #f9f9f9
  padding: 15px
  box-sizing: border-box
  height: 38.2vh
  max-height: 38.2vh
  overflow-y: auto
  h3.widget-title
    font-size: 20px
    color: #000
    font-weight: bold
    margin-bottom: 15px
  a
    margin-right: 5px
    display: inline-block
    text-decoration: none
    &:hover
      color: #000 !important

@media mq-mobile
  .mobile-nav-link
    display: block
    color: color-grey
    font-weight: normal
    font-size: 1.1em
    text-decoration: none
    margin: 30px 20px
    word-break: break-word
    &:hover
      text-decoration: underline
